# Rust / ESP device build output
/device/target/
/target/

# Python host environment and caches
/host/.venv/
/host/venv/
/host/__pycache__/
/host/.pytest_cache/
/host/.ruff_cache/
/host/.mypy_cache/
/host/.coverage
/host/htmlcov/
*.py[cod]

# Local config and secrets
*.local.*
.env
.env.*
!.env.example

# Editor and OS noise
**/*.rs.bk
**/.DS_Store
.idea/
.zed/
.helix/
.nvim.lua

# Keep workspace VS Code settings trackable; ignore only user-local history/caches.
.vscode/.history/
.vscode/*.log
